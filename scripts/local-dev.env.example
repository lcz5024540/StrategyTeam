#!/usr/bin/env bash
# ============================================================
# 本地开发环境变量模板
# 使用方法:
#   cp scripts/local-dev.env.example scripts/local-dev.env
#   # 编辑 scripts/local-dev.env，填入真实值
#   source scripts/local-dev.env
#
# local-dev.env 已在 .gitignore 中，不会被提交 git。
#
# 关于 RSA 加密与 ENC(...)：
#   - 若不设置 APP_RSA_PRIVATE_KEY_PATH，所有密钥/密码直接以明文填写（仅限本地开发）
#   - 若设置了 APP_RSA_PRIVATE_KEY_PATH，可将敏感值替换为 ENC(...) 格式（推荐）
#   - 生成密钥对：bash scripts/generate-rsa-keys.sh
#   - 生成 ENC(...) 值：
#       APP_RSA_PRIVATE_KEY_PATH=/path/to/app-private-local.pem bash scripts/encrypt-secret.sh '你的明文密码'
#     或使用交互式隐藏输入，避免明文进入命令历史：
#       APP_RSA_PRIVATE_KEY_PATH=/path/to/app-private-local.pem bash scripts/encrypt-secret.sh
#     然后将输出的 ENC(...) 值替换到对应变量
# ============================================================

# RSA 私钥路径（用于解密 ENC(...) 格式的环境变量值）
# 生成方法: bash scripts/generate-rsa-keys.sh
# 本地开发可留空，生产环境必须设置
export APP_RSA_PRIVATE_KEY_PATH="/Users/jenniferni/jenifer/build/CoinStrategy/scripts/keys/app-private.pem"   # 例: /path/to/CoinStrategy/scripts/keys/app-private-local.pem

# 本地数据库（local 默认连 43.139.186.27, 账号 devuser, 密码与 test 同一份 ENC）
# 远程 DB 主机:  43.139.186.27:3306/coin_strategy
# 账号:         devuser  (local 专属, 跟 test 的 root 隔离)
# 密码:         跟 test 的 root 同一份明文 — 这里直接填 ENC(...), Spring 会用 RSA 私钥解密
export DB_HOST="43.139.186.27"
export DB_USERNAME="devuser"
export DB_PASSWORD="ENC()"   # 同 shared/secrets.env

# Polymarket 执行钱包（LIVE 模式才需要；PAPER 模式可留空）
export POLYMARKET_EXECUTION_WALLET_ADDRESS="0x645e08d13aa56af683c345f5301bcb5b8c2fc6b7"
export POLYMARKET_EXECUTION_PRIVATE_KEY="ENC()"   # 填写 ENC(...) 加密值（强烈推荐）
export POLYMARKET_EXECUTION_FUNDER_ADDRESS=""

export POLYMARKET_CLOB_API_KEY="5fc42646-cc34-d044-2e2f-82e916b10588"
export POLYMARKET_CLOB_API_SECRET="LqoP_UQAMyGb-Y8zTUUqPPo_5mt5SqTIsGDt41iFV8I="         # 填写 ENC(...) 加密值（推荐）
export POLYMARKET_CLOB_API_PASSPHRASE="10fddb3579fbeaef24415f0a46a5360c29957290ace22853ae99b15d8c43b0cf"

# Python 解释器路径（仅 sdk-mode=PYTHON 时使用）
export POLYMARKET_PYTHON_EXECUTABLE="/opt/homebrew/bin/python3.11"
