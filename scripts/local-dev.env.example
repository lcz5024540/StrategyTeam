#!/usr/bin/env bash
# ============================================================
# 本地开发环境变量模板
# 使用方法:
#   cp scripts/local-dev.env.example scripts/local-dev.env
#   # 编辑 scripts/local-dev.env，填入真实值
#   source scripts/local-dev.env
#
# local-dev.env 已在 .gitignore 中，不会被提交 git。
#
# 关于 RSA 加密与 ENC(...)：
#   - 若不设置 APP_RSA_PRIVATE_KEY_PATH，所有密钥/密码直接以明文填写（仅限本地开发）
#   - 若设置了 APP_RSA_PRIVATE_KEY_PATH，可将敏感值替换为 ENC(...) 格式（推荐）
#   - 生成密钥对：bash scripts/generate-rsa-keys.sh
#   - 生成 ENC(...) 值：
#       1. 先填明文启动应用
#       2. POST /strategy/api/smart-wallet/admin/encrypt-secret
#          Body: {"value": "你的明文密码"}
#       3. 将返回的 ENC(...) 值替换到对应变量
# ============================================================

# RSA 私钥路径（用于解密 ENC(...) 格式的环境变量值）
# 生成方法: bash scripts/generate-rsa-keys.sh
# 本地开发可留空，生产环境必须设置
export APP_RSA_PRIVATE_KEY_PATH=""   # 例: /path/to/CoinStrategy/scripts/keys/app-private.pem

# 本地数据库（仅在本机 MySQL 密码非空时需要设置）
export DB_USERNAME="root"
export DB_PASSWORD=""   # 明文 或 ENC(...) 格式（当 APP_RSA_PRIVATE_KEY_PATH 已设置时）

# Polymarket 执行钱包（LIVE 模式才需要；PAPER 模式可留空）
export POLYMARKET_EXECUTION_WALLET_ADDRESS=""
export POLYMARKET_EXECUTION_PRIVATE_KEY=""   # 明文 或 ENC(...) 格式（推荐）
export POLYMARKET_EXECUTION_FUNDER_ADDRESS=""

# Polymarket CLOB API（首次可留空，首次下单时会自动 derive）
export POLYMARKET_CLOB_API_KEY=""
export POLYMARKET_CLOB_API_SECRET=""         # 明文 或 ENC(...) 格式（推荐）
export POLYMARKET_CLOB_API_PASSPHRASE=""

# Python 解释器路径（仅 sdk-mode=PYTHON 时使用）
export POLYMARKET_PYTHON_EXECUTABLE="/opt/homebrew/bin/python3.11"
