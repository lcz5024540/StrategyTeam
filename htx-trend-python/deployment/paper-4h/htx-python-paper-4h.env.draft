# 草稿：未装机、不落地现网。禁止写入 49.51 / 43.139，禁止替换 paper-primary 或 LIVE env。
# 实例：htx-trend-paper-4h
# 策略：HTX_TREND_4H_V2（timeframe_profile=SWING_4H，entry=4hour，trend=1day）
# 入场保持 JavaEntryConfig 默认：Donchian lookback=20，ATR=14，ADX=14，EMA 20/60/120。
# 不要设置 LIVE R0 的 HTX_TREND_PERIOD=4hour，也不要打开长窗 Donchian 42/84/126/168。
# 密码与指纹留空；装机口令另批。

HTX_PAPER_STATE_DIR=/opt/coinstrategy/htx-trend-paper-4h/state
HTX_PYTHON_EVIDENCE_DIR=/opt/coinstrategy/htx-trend-paper-4h/evidence
HTX_PAPER_CONTRACTS=BTC-USDT,ETH-USDT,BNB-USDT,XRP-USDT,SOL-USDT,TRX-USDT,ZEC-USDT,DOGE-USDT,XMR-USDT,LINK-USDT,ADA-USDT,XLM-USDT,NEAR-USDT,BCH-USDT,UNI-USDT,SUI-USDT,AAPL-USDT,ABBV-USDT,ACNSTOCK-USDT,ADBE-USDT,AMAT-USDT,AMD-USDT,AMGN-USDT,AMZNX-USDT,ANET-USDT,AVGO-USDT,BAC-USDT,BKNG-USDT,BRKB-USDT,CATSTOCK-USDT,CMCSA-USDT,COST-USDT,CRM-USDT,CSCO-USDT,CVXSTOCK-USDT,DELL-USDT,DIS-USDT,GE-USDT,GEV-USDT,GILD-USDT,GOOGL-USDT,GS-USDT,HD-USDT,IBM-USDT,INTCX-USDT,INTU-USDT,ISRG-USDT,JNJ-USDT,JPM-USDT,KO-USDT,LIN-USDT,LLY-USDT,LMT-USDT,LRCX-USDT,MCD-USDT,MDT-USDT,META-USDT,MO-USDT,MRK-USDT,MSFT-USDT,MU-USDT,NFLX-USDT,NOW-USDT,NVDA-USDT,ORCL-USDT,PANW-USDT,PEP-USDT,PG-USDT,PLTRX-USDT,QCOM-USDT,SBUX-USDT,SNDK-USDT,TSLAX-USDT,TXN-USDT,UBER-USDT,UNH-USDT,V-USDT,WMT-USDT,XOM-USDT,SPY-USDT,SPX500-USDT,QQQ-USDT,NASDAQ100-USDT
HTX_PAPER_EQUITY_USDT=300
HTX_PAPER_MAX_MARGIN_RATE=0.10
HTX_PAPER_MAX_ACTIVE_POSITIONS=5
HTX_PAPER_LEVERAGE=10

# 镜像库与 15m PAPER 同库，靠 strategy_name + instance 区分。未授权不得填写真实主机。
HTX_PAPER_DB_HOST=
HTX_PAPER_DB_PORT=3306
HTX_PAPER_DB_DATABASE=htx_trade_strategy
HTX_PAPER_DB_USER=
HTX_PAPER_DB_PASSWORD=
