# Set per instance. No credentials, no authority to deploy or trade.
HTX_RUNTIME_STATE_DIR=/opt/coinstrategy/state/INSTANCE_KEY/runtime-state
HTX_HOLDING_ADOPTION_PATH=/opt/coinstrategy/handoff/INSTANCE_KEY/adoption-final.json
# Enable only for the first verified migration, then remove.
HTX_CONTINUITY_INITIALIZE=false
HTX_MANAGED_PREVIOUS_STRATEGIES=[]
