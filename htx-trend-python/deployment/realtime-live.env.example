# Packaging reference only. Not a complete runtime/account configuration.
# Runtime instance must explicitly bind HTX_REALTIME_STRUCTURE_15M_V1 / INTRADAY_15M.
# Preserve the current account writer and reviewed holding ownership on deployment.
HTX_RT_ENTRY_ENABLED=false
HTX_TREND_PROFILES=INTRADAY_15M
HTX_TREND_ALLOW_LEGACY_4H_LIVE=false
# Account, 52-contract list, evidence paths and genuine admission are supplied only
# by a reviewed future deployment operation. No credentials or approval here.
# Minute/trade target research has NOT been promoted to the runtime strategy.
# Trial controls: <=2U / 20U loss, <=10 occupied slots, 24h / 10 completed trades.
# HTX_RT_TRIAL_APPROVAL_PATH must bind a separately sealed MANAGEMENT/TRIAL artifact.
# No automatic first-intent pause. Activation is explicit and restart cannot renew.
# Do not enable entry or install this example as a production env.
# Optional local capture tiering: original gzip bytes and hash paths are retained.
# Not compatible with HTX_RT_CAPTURE_SEGMENTED=true or COS enrollment.
HTX_RT_CAPTURE_LOCAL_ARCHIVE=false
# Required explicitly if enabled; reviewed proposal is a 5GiB whole-disk reserve.
# HTX_RT_CAPTURE_MIN_FREE_BYTES=5368709120
# Hot trigger/target: 80%/60% of unchanged HTX_RT_CAPTURE_MAX_BYTES.
# Cold history is never automatically deleted. New package/trial authority required.
