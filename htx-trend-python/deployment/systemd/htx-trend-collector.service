[Unit]
Description=HTX Trend Research Kline Collector
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/coinstrategy/htx-trend-py
Environment="PYTHONPATH=/opt/coinstrategy/htx-trend-py/src"

ExecStartPre=/bin/mkdir -p /opt/coinstrategy/htx-trend-py/data /opt/coinstrategy/htx-trend-py/logs /opt/coinstrategy/htx-trend-py/run
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/data
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/logs
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/run

ExecStart=/opt/coinstrategy/htx-trend-py/.venv/bin/python -m htx_trend.research.collectors.continuous_collector --config /opt/coinstrategy/htx-trend-py/configs/collector.yaml

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=htx-trend-collector

[Install]
WantedBy=multi-user.target
