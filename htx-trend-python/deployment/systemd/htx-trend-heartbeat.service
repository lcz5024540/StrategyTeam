[Unit]
Description=HTX Trend Research Heartbeat Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/coinstrategy/htx-trend-py
Environment="PYTHONPATH=/opt/coinstrategy/htx-trend-py/src"

ExecStartPre=/bin/mkdir -p /opt/coinstrategy/htx-trend-py/data /opt/coinstrategy/htx-trend-py/logs /opt/coinstrategy/htx-trend-py/run
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/data
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/logs
ReadWritePaths=-/opt/coinstrategy/htx-trend-py/run

ExecStart=/opt/coinstrategy/htx-trend-py/.venv/bin/python -m htx_trend.research.ops.heartbeat \
    --interval 60 \
    --file /opt/coinstrategy/htx-trend-py/run/heartbeat.txt

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=htx-trend-heartbeat

[Install]
WantedBy=multi-user.target
