# Copy to a host-local protected file. Never commit populated values.
COINSTRATEGY_DB_HOST=db.example.internal
COINSTRATEGY_DB_PORT=3306
COINSTRATEGY_DB_DATABASE=coin_strategy
COINSTRATEGY_DB_USER=replace_me
COINSTRATEGY_DB_PASSWORD=replace_me

# Required only when account credentials in MySQL use ENC(...).
APP_RSA_PRIVATE_KEY_PATH=/etc/coinstrategy/keys/app-rsa-private.pem

# Public market-data endpoint and immutable file evidence root.
HTX_PUBLIC_BASE_URL=https://api.hbdm.com
HTX_PYTHON_EVIDENCE_DIR=/var/lib/coinstrategy/htx-python-evidence

# Runtime selection. Account API keys are read from MySQL, not this file.
HTX_TREND_CONTRACTS=BTC-USDT,ETH-USDT
HTX_TREND_STRATEGY_ADMISSION_PATH=/etc/coinstrategy/admission/htx-trend.json

# Independent timeframe lifecycles behind one account writer lock.
# INTRADAY_15M uses 15min entry / 60min trend data. SWING_4H uses 4hour / 1day.
# Both profiles can trade, but one active profile owns a contract until its
# position reaches a terminal state. Keep SWING_4H false until its own PAPER
# and admission evidence authorise live orders.
HTX_TREND_PROFILES=INTRADAY_15M,SWING_4H
HTX_TREND_INTRADAY_15M_LIVE_ENABLED=true
HTX_TREND_SWING_4H_LIVE_ENABLED=false
