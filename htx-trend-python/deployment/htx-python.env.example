# Copy to a host-local protected file. Never commit populated values.
COINSTRATEGY_DB_HOST=db.example.internal
COINSTRATEGY_DB_PORT=3306
COINSTRATEGY_DB_DATABASE=coin_strategy
COINSTRATEGY_DB_USER=replace_me
COINSTRATEGY_DB_PASSWORD=replace_me

# Required only when account credentials in MySQL use ENC(...).
APP_RSA_PRIVATE_KEY_PATH=/etc/coinstrategy/keys/app-rsa-private.pem

# Public market-data endpoint and immutable file evidence root.
HTX_PUBLIC_BASE_URL=https://api.hbdm.com
HTX_PYTHON_EVIDENCE_DIR=/var/lib/coinstrategy/htx-python-evidence

# Runtime selection. Account API keys are read from MySQL ENC(...), not this file.
HTX_TREND_CONTRACTS=BTC-USDT,ETH-USDT
HTX_TREND_PERIOD=4hour
HTX_TREND_STRATEGY_ADMISSION_PATH=/etc/coinstrategy/admission/htx-trend.json

# Formal automatic LIVE (python -m htx_trend.worker). Package alone does NOT enable trading.
HTX_PYTHON_EXIT_PARITY_APPROVED=true
HTX_TREND_MIXED_MARKET_REQUIRES_STRONG_CANDIDATE=false
HTX_TREND_ENABLED=true
HTX_TREND_OBSERVE_ONLY=false
HTX_TREND_ENTRY_ENABLED=true
HTX_TREND_MAX_ACTIVE_POSITIONS=5
HTX_TREND_RISK_PER_TRADE_USDT=6
HTX_TREND_MAX_TOTAL_RISK_USDT=30
HTX_TREND_MAX_SAME_DIRECTION_POSITIONS=3
# FORBIDDEN: HTX_ACCESS_KEY HTX_SECRET_KEY HTX_API_KEY HTX_TREND_MIRROR_*

# 0.1.1-probe only (copy to $STATE/probe.env). Formal worker ignores probe CLI.
# LIVE_1CONTRACT_PROBE must be exactly 1 or true to place open/close.
# LIVE_1CONTRACT_PROBE=0
# Optional pin; SQL still requires account_role=PRIMARY AND enabled=1 AND trend_enabled=1
# HTX_PROBE_ACCOUNT_ID=1
# FORBIDDEN in this file: HTX_ACCESS_KEY HTX_SECRET_KEY HTX_API_KEY HTX_TREND_MIRROR_*
