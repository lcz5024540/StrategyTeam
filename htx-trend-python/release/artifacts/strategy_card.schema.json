{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "synthetic",
    "candidate",
    "strategy_version",
    "timeframe_profile",
    "hypothesis",
    "limitations",
    "feature_keys",
    "experiment_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "candidate": {
      "type": "boolean",
      "const": true
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1
    },
    "timeframe_profile": {
      "type": "string",
      "enum": [
        "INTRADAY_15M",
        "SWING_4H"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feature_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "experiment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
