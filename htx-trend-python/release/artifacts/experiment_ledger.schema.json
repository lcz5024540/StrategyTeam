{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "synthetic",
    "candidate",
    "experiments"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "candidate": {
      "type": "boolean",
      "const": true
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "hypothesis",
          "feature_keys",
          "status",
          "conclusion"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "feature_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "const": "SYNTHETIC_ONLY"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    }
  }
}
