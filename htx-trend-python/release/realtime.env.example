# Candidate only. Copy selected values into a separately reviewed instance env.
# Existing DB/key/admission configuration is deliberately absent.
HTX_RT_ENTRY_ENABLED=false
HTX_RT_BAND_ATR=0.10
HTX_RT_MIN_NET_R=1.5
# Examples, not selected/validated profitable parameters.
HTX_RT_PAPER_LATENCY_MS=250
HTX_RT_CAPTURE_MAX_BYTES=2147483648
HTX_RT_CAPTURE_DIR=/srv/htx/realtime-15m/capture
HTX_PYTHON_EVIDENCE_DIR=/srv/htx/realtime-15m/evidence
HTX_RUNTIME_STATE_DIR=/srv/htx/realtime-15m/runtime-state
HTX_PAPER_STATE_DIR=/srv/htx/realtime-15m/paper-state
HTX_PAPER_EVIDENCE_FORMAT=compact-v2
# Existing adoption must explicitly list old owners when replacing an instance.
HTX_MANAGED_PREVIOUS_STRATEGIES=[]
# HTX_HOLDING_ADOPTION_PATH=/path/to/reviewed-final-adoption.json
# Do not set HTX_CONTINUITY_INITIALIZE on every restart.
