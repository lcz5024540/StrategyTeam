[Unit]
Description=CoinStrategy approved verified local segment release
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/coinstrategy/15m-cos-release.enabled

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
Environment=PYTHONPATH=/opt/coinstrategy/15m-market-data/releases/0.1.7-realtime-candidate-869660ab/src
ExecStart=/home/ubuntu/coinstrategy-cos-pilot/venv/bin/python /opt/coinstrategy/15m-cos-maintenance/current/release_verified.py --config /etc/coinstrategy/15m-cos-archive.json --credentials /home/ubuntu/coinstrategy-cos-pilot/credentials.json --policy /etc/coinstrategy/15m-cos-release.json --workspace /home/ubuntu/coinstrategy-cos-archive/15m-release-work
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/coinstrategy-cos-archive/15m-release-work /home/ubuntu/coinstrategy-data/15m-cos/capture/segments
PrivateTmp=true

