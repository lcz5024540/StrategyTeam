#!/usr/bin/env bash

# Web 服务统一对外提供页面、查询、修复与内部代理入口
export SERVER_ADDRESS="127.0.0.1"
export SERVER_PORT="8080"

# ============================================================
# 单机双服务部署 JVM 内存配置 (总 3.6GB VM):
#   web: Xms 128m / Xmx 384m  (本服务: API 网关 + 本地化 read service, 无大缓存)
#   job: Xms 512m / Xmx 1024m (跑业务逻辑, 见 smart-wallet-job.env)
#   合计 heap: ~1.4GB, +Metaspace/直接内存 ~1.6GB, 系统 ~1GB, 留 1GB buffer
# 关键参数:
#   -Xss512k                          缩小线程栈 (默认 1m), 几百个线程能省 ~200MB
#   -XX:MaxMetaspaceSize=192m         限制类元数据空间
#   -XX:ReservedCodeCacheSize=128m    限制 JIT 编译缓存
#   -XX:+ExitOnOutOfMemoryError       OOM 立刻退出, 不僵死, 配合 systemd 自动拉起
#   -XX:+UseStringDeduplication       G1 字符串去重, 省一点堆
# ============================================================
export JAVA_OPTS="-Xms128m -Xmx384m \
-Xss512k \
-XX:+UseG1GC \
-XX:MaxGCPauseMillis=200 \
-XX:MaxMetaspaceSize=192m \
-XX:ReservedCodeCacheSize=128m \
-XX:+UseStringDeduplication \
-XX:+ExitOnOutOfMemoryError"

# web -> job 内网调用地址
export DASHBOARD_JOB_BASE_URL="http://127.0.0.1:8081"
