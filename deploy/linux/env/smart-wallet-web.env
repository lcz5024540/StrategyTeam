#!/usr/bin/env bash
# ============================================================
# [DEPRECATED] 顶层 smart-wallet-web.env
# 新位置: deploy/linux/env/test/smart-wallet-web.env
#         (配合 deploy/linux/env/shared/secrets.env 加载)
#
# 注意: 新架构下 web 不再调用 job，已移除 DASHBOARD_JOB_BASE_URL。
# 本文件保留为 startup 脚本的 fallback。新部署请直接用 test/ 子目录下的文件。
# ============================================================
echo "[smart-wallet-web.env] WARNING: deprecated path, prefer deploy/linux/env/test/smart-wallet-web.env" >&2

# ── fallback: 复用新版 test/web env ─────────────────────────────────────────
_SHARED_FILE="$(dirname "${BASH_SOURCE[0]:-$0}")/shared/secrets.env"
_TEST_WEB_FILE="$(dirname "${BASH_SOURCE[0]:-$0}")/test/smart-wallet-web.env"
[ -f "$_SHARED_FILE" ] && source "$_SHARED_FILE"
[ -f "$_TEST_WEB_FILE" ] && source "$_TEST_WEB_FILE"
