#!/usr/bin/env bash
# htx.env.example — HTX 现货执行服务环境变量模板（复制为 htx.env 后填真值，htx.env 不进 git）
export HTX_ACCESS_KEY=""
export HTX_SECRET_KEY=""
export HTX_SPOT_ACCOUNT_ID=""
export HTX_TRADE_ENABLED="false"

# 做市默认只开 XAUT/USDT。已有其他币种持仓仍由服务继续管理卖腿。
export HTX_MM_ENABLED="false"
export HTX_MM_SYMBOLS="xautusdt"
export HTX_MM_STOP_LOSS_ENABLED="false"
export HTX_MM_SELL_LINGER_EXIT_ENABLED="false"

# XAUT-USDT 75x 合约自动往返。模板严格保持 dry-run=true/live-enabled=false。
export HTX_CONTRACT_ENABLED="false"
export HTX_CONTRACT_DRY_RUN="true"
export HTX_CONTRACT_LIVE_ENABLED="false"
export HTX_CONTRACT_CODES="XAUT-USDT"
export HTX_CONTRACT_LEVERAGE="75"
export HTX_CONTRACT_MAX_LEVERAGE="75"
export HTX_CONTRACT_AUTO_TEST_ENABLED="false"
export HTX_CONTRACT_AUTO_LIVE_ENABLED="false"
export HTX_CONTRACT_AUTO_TEST_INTERVAL_MS="500"
export HTX_CONTRACT_AUTO_TEST_QUOTE_NOTIONAL="500"
export HTX_CONTRACT_AUTO_FAST_IOC_ENABLED="true"
export HTX_CONTRACT_MAX_SINGLE_NOTIONAL="1100"
export HTX_CONTRACT_FAST_IOC_CLOSE_RETRY_ATTEMPTS="3"
export HTX_CONTRACT_INSUFFICIENT_MARGIN_BACKOFF_MS="300000"
export HTX_CONTRACT_AUTO_TEST_TARGET_RETURN_PCT="0.006"

# 专用库 htx_trade_strategy（首次启动 createDatabaseIfNotExist=true 自动建库 + schema.sql 建表）
export HTX_DB_HOST="127.0.0.1"
export HTX_DB_PORT="3306"
export HTX_DB_USERNAME="root"
export HTX_DB_PASSWORD=""
