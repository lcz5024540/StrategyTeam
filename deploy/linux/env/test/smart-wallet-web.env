#!/usr/bin/env bash
# ============================================================
# test/smart-wallet-web.env — TEST 环境 web 服务专属配置
# 部署机:   43.139.186.27 (web + 前端)
# DB:       49.51.250.174:3306 (统一远程 DB, 跟 job 完全一致) as root
# 依赖加载: 启动脚本会先 source ../shared/secrets.env 再 source 本文件
# ============================================================

export SPRING_PROFILES_ACTIVE="test"

# ── 服务监听 ────────────────────────────────────────────────────────────────
export SERVER_ADDRESS="127.0.0.1"
export SERVER_PORT="8080"

# ── 数据库（远程统一: 49.51.250.174）─────────────────────────────────────
export DB_HOST="49.51.250.174"
export DB_USERNAME="root"
# DB_PASSWORD 来自 shared/secrets.env (ENC 密文)

# ── JVM 内存（web 轻负载, 对接前端 API）──────────────────────────────────
export JAVA_OPTS="-Xms128m -Xmx384m \
-Xss512k \
-XX:+UseG1GC \
-XX:MaxGCPauseMillis=200 \
-XX:MaxMetaspaceSize=192m \
-XX:ReservedCodeCacheSize=128m \
-XX:+UseStringDeduplication \
-XX:+ExitOnOutOfMemoryError"

# 注意: 新架构下 web 不再调用 job, DASHBOARD_JOB_BASE_URL 已废弃, 不要再设置。
