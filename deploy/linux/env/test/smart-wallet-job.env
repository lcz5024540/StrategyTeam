#!/usr/bin/env bash
# ============================================================
# test/smart-wallet-job.env — TEST 环境 job 服务专属配置
# 部署机:   49.51.250.174 (本机就是 DB 宿主)
# DB:       49.51.250.174:3306 (跟 web test 统一) as root
#           job 与 DB 同机, 走 127.0.0.1 或公网 IP 都通; 这里统一用公网 IP, 跟 web 行为一致
# 网络:     job 仅监听 127.0.0.1, 对外完全不可达
# 依赖加载: 启动脚本会先 source ../shared/secrets.env 再 source 本文件
# ============================================================

export SPRING_PROFILES_ACTIVE="test"

# ── 服务监听（强制 loopback, job 永远不对外）─────────────────────────────
export SERVER_ADDRESS="127.0.0.1"
export SERVER_PORT="8081"

# ── 数据库（统一远程 DB: 49.51.250.174 as root）─────────────────────────────
# 跟 web test 完全一致, 整个 test 环境共用同一份 DB 凭证。
export DB_HOST="49.51.250.174"
export DB_USERNAME="root"
# DB_PASSWORD 来自 shared/secrets.env (ENC 密文)

# ── JVM 内存（job 是主业务进程, 跑策略 / @Scheduled / Polymarket 同步）───
export JAVA_OPTS="-Xms512m -Xmx1024m \
-Xss512k \
-XX:+UseG1GC \
-XX:MaxGCPauseMillis=200 \
-XX:MaxMetaspaceSize=256m \
-XX:ReservedCodeCacheSize=192m \
-XX:+UseStringDeduplication \
-XX:+ExitOnOutOfMemoryError"
