#!/usr/bin/env bash
# ============================================================
# [DEPRECATED] 顶层 smart-wallet-job.env
# 新位置: deploy/linux/env/test/smart-wallet-job.env
#         (配合 deploy/linux/env/shared/secrets.env 加载)
#
# 本文件保留为 startup 脚本的 fallback。新部署请直接用 test/ 子目录下的文件。
# ============================================================
echo "[smart-wallet-job.env] WARNING: deprecated path, prefer deploy/linux/env/test/smart-wallet-job.env" >&2

# ── fallback: 复用新版 test/job env ─────────────────────────────────────────
_SHARED_FILE="$(dirname "${BASH_SOURCE[0]:-$0}")/shared/secrets.env"
_TEST_JOB_FILE="$(dirname "${BASH_SOURCE[0]:-$0}")/test/smart-wallet-job.env"
[ -f "$_SHARED_FILE" ] && source "$_SHARED_FILE"
[ -f "$_TEST_JOB_FILE" ] && source "$_TEST_JOB_FILE"
