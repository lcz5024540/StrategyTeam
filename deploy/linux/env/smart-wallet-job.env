#!/usr/bin/env bash

# Job 服务仅负责策略运行与内部数据处理
export SERVER_ADDRESS="127.0.0.1"
export SERVER_PORT="8081"

# ============================================================
# 单机双服务部署 JVM 内存配置 (总 3.6GB VM):
#   web: Xms 128m / Xmx 384m  (见 smart-wallet-web.env)
#   job: Xms 512m / Xmx 1024m (本服务: 跑业务逻辑 / @Scheduled / Polymarket 同步)
# 关键参数同 web, 此处堆稍大留给业务流程.
# ============================================================
export JAVA_OPTS="-Xms512m -Xmx1024m \
-Xss512k \
-XX:+UseG1GC \
-XX:MaxGCPauseMillis=200 \
-XX:MaxMetaspaceSize=256m \
-XX:ReservedCodeCacheSize=192m \
-XX:+UseStringDeduplication \
-XX:+ExitOnOutOfMemoryError"

# ── RSA 私钥（必须）─────────────────────────────────────────────────────────
export APP_RSA_PRIVATE_KEY_PATH="/opt/coinstrategy/app-private.pem"

# ── 数据库配置 ──────────────────────────────────────────────────────────────
# export SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/coin_strategy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai"
export DB_USERNAME="root"
export DB_PASSWORD="ENC()"

export BINANCE_API_KEY=""
export BINANCE_SECRET_KEY=""

export POLYMARKET_EXECUTION_WALLET_ADDRESS="0x645e08d13aa56af683c345f5301bcb5b8c2fc6b7"
export POLYMARKET_EXECUTION_PRIVATE_KEY="ENC()"
export POLYMARKET_EXECUTION_FUNDER_ADDRESS=""

export POLYMARKET_CLOB_API_KEY="5fc42646-cc34-d044-2e2f-82e916b10588"
export POLYMARKET_CLOB_API_SECRET="LqoP_UQAMyGb-Y8zTUUqPPo_5mt5SqTIsGDt41iFV8I="
export POLYMARKET_CLOB_API_PASSPHRASE="10fddb3579fbeaef24415f0a46a5360c29957290ace22853ae99b15d8c43b0cf"

export POLYMARKET_PYTHON_EXECUTABLE="/usr/bin/python3"
export SMART_WALLET_EXECUTION_WALLET_HELPER_SCRIPT_PATH="/opt/coinstrategy/smart-wallet/runtime/polymarket_clob_client.py"
export POLY_HTTP_CONNECT_RETRIES="2"
export POLY_HTTP_REQUEST_ATTEMPTS="3"
export POLY_HTTP_CONNECT_TIMEOUT_SECONDS="10"
export POLY_HTTP_READ_TIMEOUT_SECONDS="30"
export POLY_HTTP_WRITE_TIMEOUT_SECONDS="30"
export POLY_HTTP_POOL_TIMEOUT_SECONDS="10"
export POLY_HTTP_RETRY_BASE_SLEEP_SECONDS="0.4"
export POLYMARKET_PYTHON_TIMEOUT_SECONDS="45"
