[Unit]
Description=CoinStrategy Smart Wallet Backend
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_HOME__
Environment=SMART_WALLET_ENV_FILE=__ENV_FILE__
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=__APP_HOME__/bin/start-smart-wallet-backend.sh
SuccessExitStatus=143
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=__APP_HOME__/logs __APP_HOME__/runtime

[Install]
WantedBy=multi-user.target
