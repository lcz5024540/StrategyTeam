[Unit]
Description=CoinStrategy Smart Wallet Backend (__ENV__)
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_HOME__

# 环境变量
Environment=SMART_WALLET_ENV_FILE=__ENV_FILE__
Environment=SPRING_PROFILES_ACTIVE=__ENV__
Environment=LOG_DIR=/opt/coinstrategy/smart-wallet/logs
Environment=JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

ExecStart=/bin/bash -lc 'set -a; [ -f "$$SMART_WALLET_ENV_FILE" ] && source "$$SMART_WALLET_ENV_FILE"; set +a; exec /usr/bin/java $${JAVA_OPTS:--Xms512m -Xmx1024m -XX:+UseG1GC} -Dspring.profiles.active=$${SPRING_PROFILES_ACTIVE:-__ENV__} -Dlog.dir=$${LOG_DIR:-/opt/coinstrategy/smart-wallet/logs} -jar __APP_HOME__/backend/app.jar'

SuccessExitStatus=143
Restart=always
RestartSec=5
LimitNOFILE=65535

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/coinstrategy/smart-wallet/logs __APP_HOME__/runtime

[Install]
WantedBy=multi-user.target
