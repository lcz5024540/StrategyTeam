# Cross-exchange funding service: public market data and Paper execution only.
SPRING_PROFILES_ACTIVE=test,funding
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8083
DB_HOST=127.0.0.1
DB_USERNAME=root
LOG_DIR=/opt/coinstrategy/funding-paper/logs
FUNDING_CAPTURE_OUTPUT_DIRECTORY=/opt/coinstrategy/funding-paper/data/funding-replay
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
