<mxfile host="app.diagrams.net" modified="2026-10-18T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="htx-python-strategy-code-guide-v1-entry-flowchart" name="Page-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="HTX Python 候选到开仓流程" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="800" height="30" as="geometry" /></mxCell><mxCell id="start" value="profile tick&#10;15m 或 4h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="180" height="70" as="geometry" /></mxCell><mxCell id="lock" value="writer lock&#10;回查未决订单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="210" height="70" as="geometry" /></mxCell><mxCell id="manage" value="先管理本 profile 持仓&#10;硬止损优先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="230" height="70" as="geometry" /></mxCell><mxCell id="bar" value="新闭合K线？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="160" height="80" as="geometry" /></mxCell><mxCell id="scan" value="并发扫描合约&#10;entry/trend/confirmation窗口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="260" height="100" as="geometry" /></mxCell><mxCell id="evidence" value="证据可落盘且多周期完整？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="230" height="90" as="geometry" /></mxCell><mxCell id="signal" value="指标快照 + long/short评分&#10;方向/Regime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="270" width="260" height="90" as="geometry" /></mxCell><mxCell id="candidate" value="Donchian / Fibonacci / EMA动量&#10;生成止损/目标/expected R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="260" height="100" as="geometry" /></mxCell><mxCell id="policy" value="匹配DB policy&#10;基础分阈值 + 市场排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="450" width="260" height="90" as="geometry" /></mxCell><mxCell id="shadow" value="profile LIVE开关？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="450" width="220" height="80" as="geometry" /></mxCell><mxCell id="queue" value="窗口/新鲜度/容量排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="260" height="80" as="geometry" /></mxCell><mxCell id="mutex" value="同账户同合约互斥&#10;PROFILE_CONTRACT_MUTEX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="250" height="80" as="geometry" /></mxCell><mxCell id="gate" value="正式 Gate 顺序&#10;资金费→新鲜度→冷却→市场→结构&#10;→盘口→风险→流动性→成本→保证金" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="590" width="290" height="130" as="geometry" /></mxCell><mxCell id="reserve" value="0.5%单笔 / 1.5%总风险&#10;最多3仓 + 原子预占" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="250" height="100" as="geometry" /></mxCell><mxCell id="intent" value="先写 position/order intent&#10;再设置杠杆并提交HTX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="790" width="250" height="100" as="geometry" /></mxCell><mxCell id="reconcile" value="按 client_order_id 回查&#10;部分成交增量入账&#10;UNKNOWN 不重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="790" width="270" height="100" as="geometry" /></mxCell><mxCell id="open" value="exchange-confirmed OPEN&#10;绑定 timeframe_profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="230" height="80" as="geometry" /></mxCell><mxCell id="stopnew" value="FAIL/UNKNOWN/SHADOW&#10;只记录，不新增风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="650" width="240" height="90" as="geometry" /></mxCell><mxCell id="e1" value="每tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="start" target="lock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="顺序1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lock" target="manage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="无管理失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="manage" target="bar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bar" target="scan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="否：复用缓存候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bar" target="queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="窗口+盘口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="scan" target="evidence"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="完整" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="evidence" target="signal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="失败/UNKNOWN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="evidence" target="stopnew"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="评分达标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="signal" target="candidate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="candidate" target="policy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="selected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="policy" target="shadow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="关闭：SHADOW_ONLY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="shadow" target="stopnew"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="开启" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="shadow" target="queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="逐候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="queue" target="mutex"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="无冲突" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mutex" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="已有另一profile持仓" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mutex" target="stopnew"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="READY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gate" target="reserve"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="任一门禁失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gate" target="stopnew"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="预占成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="reserve" target="intent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="预占失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;ht