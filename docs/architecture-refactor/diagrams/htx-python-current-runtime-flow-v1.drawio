        <mxCell id="lane-tick" value="LIVE 每个 tick：先保护已有仓位，再找新机会" style="swimlane;horizontal=0;startSize=38;rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="2100" height="260" as="geometry"/></mxCell>
