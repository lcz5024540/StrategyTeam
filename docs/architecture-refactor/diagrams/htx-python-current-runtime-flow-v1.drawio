        <mxCell id="t2" value="reconcile_pending&#xa;按原 client order id 回查&#xa;不重发订单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-tick"><mxGeometry x="255" y="45" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="t3" value="LivePositionManager.manage&#xa;硬止损优先&#xa;v4 / legacy 退出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-tick"><mxGeometry x="510" y="45" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="t4" value="持仓管理失败?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-tick"><mxGeometry x="780" y="45" width="140" height="85" as="geometry"/></mxCell>
        <mxCell id="t5" value="DEGRADED&#xa;本轮不新开仓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-tick"><mxGeometry x="970" y="20" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="t6" value="新的稳定 15m close?&#xa;now - 10s grace" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-tick"><mxGeometry x="970" y="120" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="t7" value="否：复用 pending 候选&#xa;freshness 600s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lane-tick"><mxGeometry x="1220" y="125" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="t8" value="是：扫描前读取历史 breadth&#xa;35min / ≥20 symbols&#xa;70% 同向且反向≤15%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-tick"><mxGeometry x="1220" y="25" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="t9" value="并行扫描合约&#xa;默认 52 contracts / 6 workers&#xa;entry=15m×160&#xa;trend=60m×160 当前未用于决策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-tick"><mxGeometry x="1510" y="35" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="t10" value="BTC/ETH anchor&#xa;15m/30m/60m/4h&#xa;close 单步方向 + EMA8/21&#xa;≥4 信号、2币种、反向≤1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-tick"><mxGeometry x="1810" y="35" width="230" height="120" as="geometry"/></mxCell>

        <mxCell id="lane-calc" value="单合约决策核：已闭合 K 线 → 指标 → 分数 → 候选" style="swimlane;horizontal=0;startSize=38;rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2100" height="300" as="geometry"/></mxCell>
        <mxCell id="c1" value="HtxMarketData.kline_window&#xa;请求 size+1&#xa;排序 / 去重 / 排除未闭合 bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-calc"><mxGeometry x="70" y="65" width="225" height="95" as="geometry"/></mxCell>
        <mxCell id="c2" value="HtxStrategyDecisionEngine&#xa;作用面准入&#xa;input/config/decision hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-calc"><mxGeometry x="345" y="65" width="225" height="95" as="geometry"/></mxCell>
        <mxCell id="c3" value="snapshot 指标&#xa;EMA20/60/120&#xa;ATR14 / ATR% / ADX14 / ROC12&#xa;VWAP20 / RSI14 / MACD12-26-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-calc"><mxGeometry x="620" y="45" width="255" height="135" as="geometry"/></mxCell>
        <mxCell id="c4" value="ensemble score&#xa;EMA +30/12&#xa;ROC ≤20 / breakout +20&#xa;ADX +10 / ATR% +10 / volume +10&#xa;score≥60 且 gap≥12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-calc"><mxGeometry x="925" y="40" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="c5" value="regime&#xa;LOW_VOLATILITY&#xa;TRENDING_UP / TRENDING_DOWN&#xa;RANGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-calc"><mxGeometry x="1235" y="55" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="c6" value="三个候选可并存&#xa;Donchian breakout&#xa;Fibonacci pullback&#xa;EMA momentum&#xa;各算 invalidation/target/expected R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-calc"><mxGeometry x="1485" y="40" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="c7" value="重要边界&#xa;没有 K线/EMA/成交量回归斜率&#xa;ROC 是端点收益率，不是斜率&#xa;VWAP/RSI/MACD 已算但不参与当前候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane-calc"><mxGeometry x="1785" y="35" width="255" height="155" as="geometry"/></mxCell>

