        <mxCell id="e1" value="DB policy 精确匹配&#xa;primary model + confirmations&#xa;base score ≥ threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-entry"><mxGeometry x="70" y="55" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="e2" value="market adjustment&#xa;顺向 +8×weight&#xa;反向 -12×weight&#xa;无共识 -2×weight&#xa;排序 effective→base→R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-entry"><mxGeometry x="350" y="45" width="235" height="120" as="geometry"/></mxCell>
        <mxCell id="e3" value="Entry Gate 固定顺序&#xa;funding→freshness→cooldown→market/state&#xa;→Fib quality→structure→spread/ATR&#xa;→orders/position→chase→sizing&#xa;→turnover/depth→cost→margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-entry"><mxGeometry x="635" y="35" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="e4" value="sizing&#xa;planned notional = policy × local × adaptive&#xa;V1: min(byTarget, byMax)&#xa;新版本: 再受 byRisk 限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-entry"><mxGeometry x="985" y="45" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="e5" value="设置杠杆&#xa;Fib entry-cycle claim&#xa;先写 position/order INTENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-entry"><mxGeometry x="1295" y="55" width="220" height="100" as="geometry"/></mxCell>
