<mxfile host="app.diagrams.net"><diagram name="Realtime structure entry"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bars" value="闭合 1h / 15m → EMA方向、20/32结构、ATR" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="290" height="70" as="geometry" /></mxCell><mxCell id="plans" value="结构计划：反弹回落 / 突破回踩" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="290" height="70" as="geometry" /></mxCell><mxCell id="ticks" value="公开 WS：成交 / BBO / 连接代次" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="290" height="70" as="geometry" /></mxCell><mxCell id="trigger" value="两笔不同成交 + 新鲜BBO触发" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="290" height="70" as="geometry" /></mxCell><mxCell id="gate" value="盘口 / 净R / 预算 / 保护退出重入门" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="290" height="70" as="geometry" /></mxCell><mxCell id="writer" value="唯一 writer：持久意图 → IOC限价" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="290" height="70" as="geometry" /></mxCell><mxCell id="hold" value="逐笔实际仓位 + 原归属参数快照" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="290" height="70" as="geometry" /></mxCell><mxCell id="stop" value="实时初始止损（WS / REST）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="290" height="70" as="geometry" /></mxCell><mxCell id="exit" value="闭合15m趋势 / 保护退出" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="640" width="290" height="70" as="geometry" /></mxCell><mxCell id="ledger" value="统一订单恢复、成交账本 / compact-v2" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="770" width="290" height="70" as="