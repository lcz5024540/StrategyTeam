<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="A/B场景与贝叶斯验证"><mxGraphModel dx="1200" dy="760" grid="1" page="1" pageWidth="1200" pageHeight="760"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A/B 场景交易与离线贝叶斯验证｜入口默认关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="20" width="870" height="55" as="geometry" /></mxCell><mxCell id="bars" value="闭合 1h / 15m K线&#10;按接收时间重建可见修订" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="250" height="95" as="geometry" /></mxCell><mxCell id="scene" value="A 多头 / B 空头&#10;EMA + MACD + 影线&#10;不匹配 → 未分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="250" height="110" as="geometry" /></mxCell><mxCell id="quote" value="当前窗口持续等待价格&#10;≤2s新鲜盘口，价差≤10bp&#10;稳定机会ID，只提交一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="630" y="120" width="280" height="110" as="geometry" /></mxCell><mxCell id="gate" value="可选冻结概率门&#10;版本 / 成本 / 截止校验&#10;缺样本 → 拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="630" y="295" width="280" height="105" as="geometry" /></mxCell><mxCell id="exec" value="共享writer / broker / ledger&#10;深度、tick、成本、预算复核&#10;有界IOC，未知结果先恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="330" y="295" width="255" height="105" as="geometry" /></mxCell><mxCell id="exit" value="冻结三档ATR目标与止损&#10;实时盘口退出 / 未决平仓&#10;关闭新入口仍管理持仓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="35" y="295" width="250" height="105" as="geometry" /></mxCell><mxCell id="labels" value="未加门的完整影子机会流&#10;成熟净收益标签；去重 / 去重叠&#10;缺口、未平、未知费用单列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="35" y="485" width="300" height="110" as="geometry" /></mxCell><mxCell id="bayes" value="Beta(1+盈,1+非盈) ×50,000&#10;60min时间块Dirichlet ×10,000&#10;30/120min相关性敏感性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="400" y="485" width="335" height="110" as="geometry" /></mxCell><mxCell id="snap" value="离线生成下一期快照&#10;至少20完整结果 / 10小时块&#10;不将本段后验倒灌本段回放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="805" y="485" width="300" height="110" as="geometry" /></mxCell><mxCell id="footer" value="已见诊断数据 ≠ 未见验证｜报价路径 ≠ IOC成交 / 账户收益｜合并、部署与启用另行决定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#45677F;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="1030" height="55" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="bars" target="scene"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="scene" target="quote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="quote" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="gate" target="exec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="exec" target="exit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="exit" target="labels"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="labels" target="bayes"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="bayes" target="snap"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="未来独立验证" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=14;" edge="1" parent="1" source="snap" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>