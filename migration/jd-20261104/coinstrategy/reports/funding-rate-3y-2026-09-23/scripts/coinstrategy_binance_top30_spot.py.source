import concurrent.futures
import csv
import datetime as dt
import json
import pathlib
import time
import urllib.error
import urllib.parse
import urllib.request

OUT = pathlib.Path(__file__).resolve().parent.parent
START = int(dt.datetime(2023, 8, 23, tzinfo=dt.timezone.utc).timestamp() * 1000)
END = int(dt.datetime(2026, 9, 24, tzinfo=dt.timezone.utc).timestamp() * 1000)
symbols = [item['symbol'] for item in csv.DictReader((OUT / 'binance-funding-manifest.csv').open()) if int(item['count']) > 0]

def fetch(symbol):
    rows=[];cursor=START
    while cursor < END:
        url='https://api.binance.com/api/v3/klines?'+urllib.parse.urlencode({
            'symbol':symbol+'USDT','interval':'1d','startTime':cursor,'endTime':END-1,'limit':1000})
        for attempt in range(5):
            try:
                with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'CoinStrategy research'}),timeout=30) as response:
                    batch=json.load(response)
                break
            except urllib.error.HTTPError as error:
                if error.code==400:return {'symbol':symbol,'count':0,'error':'invalid symbol'}
                if attempt==4:raise
                time.sleep(1+attempt*2)
            except Exception:
                if attempt==4:raise
                time.sleep(1+attempt*2)
        if not batch:break
        rows.extend(batch)
        cursor=batch[-1][0]+86400000
        if len(batch)<1000:break
    if rows:
        path=OUT/'spot'/f'{symbol}.csv';path.parent.mkdir(exist_ok=True)
        with path.open('w',newline='') as handle:
            writer=csv.writer(handle);writer.writerow(['date_utc','open','close','quote_volume_usdt'])
            for row in rows:
                writer.writerow([dt.datetime.fromtimestamp(row[0]/1000,dt.timezone.utc).date().isoformat(),row[1],row[4],row[7]])
    print(symbol,len(rows),flush=True)
    return {'symbol':symbol,'count':len(rows),'first_date':dt.datetime.fromtimestamp(rows[0][0]/1000,dt.timezone.utc).date().isoformat() if rows else '',
            'last_date':dt.datetime.fromtimestamp(rows[-1][0]/1000,dt.timezone.utc).date().isoformat() if rows else '', 'error':''}

with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    manifest=list(pool.map(fetch,symbols))
with (OUT/'binance-spot-manifest.csv').open('w',newline='') as handle:
    writer=csv.DictWriter(handle,fieldnames=list(manifest[0]));writer.writeheader();writer.writerows(manifest)
print('spot nonempty',sum(item['count']>0 for item in manifest),flush=True)
