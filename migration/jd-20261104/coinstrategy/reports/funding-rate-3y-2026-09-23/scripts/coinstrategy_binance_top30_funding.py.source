import concurrent.futures
import csv
import datetime as dt
import json
import pathlib
import time
import urllib.error
import urllib.parse
import urllib.request

OUT = pathlib.Path(__file__).resolve().parent.parent
START = int(dt.datetime(2023, 8, 23, tzinfo=dt.timezone.utc).timestamp() * 1000)
END = int(dt.datetime(2026, 9, 23, tzinfo=dt.timezone.utc).timestamp() * 1000)
EXCLUDED = {'USDT', 'USDC', 'DAI', 'TUSD', 'BUSD', 'FDUSD', 'PYUSD',
            'USD1', 'USDG', 'USDe', 'WBTC', 'XAUt'}
ALIASES = {'PEPE': '1000PEPE', 'SHIB': '1000SHIB'}


def fetch(symbol):
    market = ALIASES.get(symbol, symbol) + 'USDT'
    rows = []
    cursor = START
    while cursor < END:
        args = urllib.parse.urlencode({'symbol': market, 'startTime': cursor,
                                       'endTime': END - 1, 'limit': 1000})
        url = 'https://fapi.binance.com/fapi/v1/fundingRate?' + args
        for attempt in range(6):
            try:
                request = urllib.request.Request(url, headers={'User-Agent': 'CoinStrategy research'})
                with urllib.request.urlopen(request, timeout=30) as response:
                    batch = json.load(response)
                break
            except urllib.error.HTTPError as error:
                if error.code == 400:
                    return {'symbol': symbol, 'market': market, 'count': 0, 'error': 'invalid symbol'}
                if attempt == 5:
                    raise
                time.sleep(2 + 2 * attempt)
            except Exception:
                if attempt == 5:
                    raise
                time.sleep(2 + 2 * attempt)
        if not batch:
            break
        rows.extend(batch)
        cursor = batch[-1]['fundingTime'] + 1
        if len(batch) < 1000:
            break
    if rows:
        hours = [row['fundingTime'] // 3600000 for row in rows]
        assert len(hours) == len(set(hours)), (symbol, 'duplicate')
        path = OUT / 'binance' / f'{symbol}.csv'
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('w', newline='') as handle:
            writer = csv.writer(handle)
            writer.writerow(['time_utc', 'funding_rate', 'mark_price'])
            for row in rows:
                writer.writerow([dt.datetime.fromtimestamp(row['fundingTime']/1000, dt.timezone.utc).isoformat(),
                                 row['fundingRate'], row['markPrice']])
    print(symbol, len(rows), flush=True)
    return {'symbol': symbol, 'market': market, 'count': len(rows),
            'first_utc': dt.datetime.fromtimestamp(rows[0]['fundingTime']/1000, dt.timezone.utc).isoformat() if rows else '',
            'last_utc': dt.datetime.fromtimestamp(rows[-1]['fundingTime']/1000, dt.timezone.utc).isoformat() if rows else '',
            'error': ''}


symbols = sorted({row['symbol'] for row in csv.DictReader((OUT / 'cmc-top30-monthly-snapshots.csv').open())} - EXCLUDED)
print('candidate count', len(symbols), flush=True)
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    manifest = list(pool.map(fetch, symbols))
with (OUT / 'binance-funding-manifest.csv').open('w', newline='') as handle:
    writer = csv.DictWriter(handle, fieldnames=list(manifest[0]))
    writer.writeheader()
    writer.writerows(manifest)
print('nonempty', sum(item['count'] > 0 for item in manifest), flush=True)
