import concurrent.futures
import csv
import datetime as dt
import json
import pathlib
import time
import urllib.request
from html.parser import HTMLParser

OUT = pathlib.Path(__file__).resolve().parent.parent
OUT.mkdir(parents=True, exist_ok=True)

class NextDataParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.active = False
        self.result = ''
    def handle_starttag(self, tag, attrs):
        if tag == 'script' and ('id', '__NEXT_DATA__') in attrs:
            self.active = True
    def handle_endtag(self, tag):
        if tag == 'script':
            self.active = False
    def handle_data(self, data):
        if self.active:
            self.result += data

def request_snapshot(date):
    url = 'https://coinmarketcap.com/historical/' + date.strftime('%Y%m%d') + '/'
    for attempt in range(5):
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            html = urllib.request.urlopen(req, timeout=30).read().decode()
            parser = NextDataParser()
            parser.feed(html)
            rows = json.loads(json.loads(parser.result)['props']['initialState'])['cryptocurrency']['listingHistorical']['data']
            assert len(rows) >= 30
            result = []
            for r in rows[:30]:
                result.append({'snapshot': date.isoformat(), 'rank': r['cmcRank'],
                               'cmc_id': r['id'], 'symbol': r['symbol'], 'name': r['name'],
                               'market_cap_usd': r['quote']['USD']['marketCap'],
                               'global_volume_24h_usd': r['quote']['USD']['volume24h'],
                               'source_url': url})
            assert [r['rank'] for r in result] == list(range(1,31))
            print(date, 'ok', flush=True)
            return result
        except Exception as exc:
            if attempt == 4:
                raise RuntimeError(f'{date}: {exc}') from exc
            time.sleep(1 + attempt * 2)

def prior_sunday(date):
    days_back = (date.weekday() + 1) % 7
    return date - dt.timedelta(days=days_back or 7)

rebalance_dates = [dt.date(2023, 9, 23)]
rebalance_dates += [dt.date(y, m, 1) for y in (2023, 2024, 2025, 2026)
                    for m in range(1, 13) if dt.date(2023, 9, 23) < dt.date(y, m, 1) < dt.date(2026, 9, 23)]
dates = sorted(set(prior_sunday(d) for d in rebalance_dates))
print('snapshots', len(dates), 'from', dates[0], 'to', dates[-1], flush=True)
with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
    all_rows = [r for group in pool.map(request_snapshot, dates) for r in group]
with (OUT / 'cmc-top30-monthly-snapshots.csv').open('w', newline='') as handle:
    writer = csv.DictWriter(handle, fieldnames=list(all_rows[0]))
    writer.writeheader()
    writer.writerows(all_rows)
print('unique symbols', sorted(set(r['symbol'] for r in all_rows)), flush=True)
