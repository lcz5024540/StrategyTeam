import concurrent.futures
import csv
import datetime as dt
import json
import pathlib
import time
import urllib.error
import urllib.parse
import urllib.request

OUT=pathlib.Path(__file__).resolve().parent.parent
START=int(dt.datetime(2023,8,23,tzinfo=dt.timezone.utc).timestamp()*1000)
END=int(dt.datetime(2026,9,24,tzinfo=dt.timezone.utc).timestamp()*1000)
funding={r['symbol']:r['market'] for r in csv.DictReader(open(OUT/'binance-funding-manifest.csv'))}
symbols=[r['symbol'] for r in csv.DictReader(open(OUT/'binance-spot-manifest.csv')) if int(r['count'])>0]

def fetch(symbol):
    rows=[];cursor=START
    while cursor<END:
        url='https://fapi.binance.com/fapi/v1/klines?'+urllib.parse.urlencode({
            'symbol':funding[symbol],'interval':'1d','startTime':cursor,'endTime':END-1,'limit':1500})
        for attempt in range(5):
            try:
                with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'CoinStrategy research'}),timeout=30) as response:
                    batch=json.load(response)
                break
            except urllib.error.HTTPError as error:
                if error.code==400:return (symbol,0)
                if attempt==4:raise
                time.sleep(1+attempt*2)
            except Exception:
                if attempt==4:raise
                time.sleep(1+attempt*2)
        if not batch:break
        rows.extend(batch)
        cursor=batch[-1][0]+86400000
        if len(batch)<1500:break
    if rows:
        path=OUT/'perp-volume'/f'{symbol}.csv';path.parent.mkdir(exist_ok=True)
        with path.open('w',newline='') as handle:
            writer=csv.writer(handle);writer.writerow(['date_utc','quote_volume_usdt'])
            for row in rows:writer.writerow([dt.datetime.fromtimestamp(row[0]/1000,dt.timezone.utc).date().isoformat(),row[7]])
    print(symbol,len(rows),flush=True)
    return (symbol,len(rows))

with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    r=list(pool.map(fetch,symbols))
print('nonempty',sum(n>0 for _,n in r),flush=True)
